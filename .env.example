# LLM 配置
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_REQUEST_TIMEOUT=60        # 单次 LLM 请求超时（秒）
LLM_MAX_RETRIES=2             # LLM 请求失败自动重试次数

# Embedding 配置
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ChromaDB 持久化路径
CHROMA_PERSIST_DIR=./chroma_db

# 检索配置
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=50
RERANK_TOP_K=5
BM25_WEIGHT=0.5

# Agent 配置
MAX_HISTORY_TURNS=5
VERIFIER_CONFIDENCE_THRESHOLD=0.7

# 热重载（开发调试时设为 1；默认 0，避免 .py 文件变动触发服务重启）
APP_RELOAD=0

# API 服务配置
API_HOST=127.0.0.1
API_PORT=8000
LOG_DIR=./logs

# CORS 允许来源（逗号分隔；上线后填具体域名，如 https://example.com）
CORS_ORIGINS=*

# 上线安全：限流 / 配额 / 上传限制 / 会话持久化
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=300
UPLOAD_LIMIT_PER_DAY=20
UPLOAD_MAX_MB=10
SESSION_DB_PATH=./data/sessions.db
SESSION_TTL_DAYS=7

# 成本 / 监控
MONITOR_DB_PATH=./data/usage.db
MONITOR_TOKEN=            # 上线前务必设置，保护 /admin/stats
COST_INPUT_PER_1M=1.0     # 元 / 百万输入 token
COST_OUTPUT_PER_1M=2.0    # 元 / 百万输出 token
