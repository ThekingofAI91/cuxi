# ============================================================
# LLM 配置
# ------------------------------------------------------------
# 本项目不内置任何 API Key，需要你自己填。两种方式任选其一：
#   ① 浏览器里填（推荐）：启动后首次打开页面会弹出配置页，
#      保存到 data/user_config.json，立即生效、无需重启
#   ② 复制本文件为 .env，把下面几项填上
# 两者同时存在时以浏览器里填的为准；删掉 data/user_config.json 即回到只用 .env。
#
# 安全红线：真实 .env 已在 .gitignore 里，任何情况下不要提交进仓库！
# ============================================================
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 备用模型：主模型额度用完/不可用时自动降级（留空则不启用）
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_REQUEST_TIMEOUT=60        # 单次 LLM 请求超时（秒）
LLM_MAX_RETRIES=2             # LLM 请求失败自动重试次数
LLM_SHARED_HTTP_CLIENT=1      # LLM 连接池跨请求复用（省每次调用的 TCP+TLS 握手）；置 0 走默认每实例独立连接

# Embedding 配置
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_CONCURRENT=4

# ChromaDB 持久化路径
CHROMA_PERSIST_DIR=./chroma_db

# 检索配置
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=50
RERANK_TOP_K=5
BM25_WEIGHT=0.5
# 重排序模型：默认 bge-reranker-base（278M）。检索级 A/B 实测与 v2-m3 的
# top-15 文档集合 24/24 完全一致、重排 1400ms→370ms（~3.9x）；追求极致精度可换回
# BAAI/bge-reranker-v2-m3（2.27GB，重排慢 ~3.9x）
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MAX_CONCURRENT=2
RERANK_CANDIDATES=5
# 重排模型 int8 动态量化（只量化 encoder 层）：实测 5 对 1925→1223ms（1.57x），
# 排序一致度实测无损头部选择；量化失败自动回退 fp32。置 0 恢复全精度
RERANK_INT8_QUANTIZE=1
# torch 推理线程数：建议 = 物理核数 // 重排并发数（16 核 / 2 = 8）
TORCH_NUM_THREADS=8

# Agent 配置
MAX_HISTORY_TURNS=5
VERIFIER_CONFIDENCE_THRESHOLD=0.7
# 异步引用核查等待预算（秒）：核查在回答定稿后补跑，超时放弃本次引用出处推送、按时发 end
VERIFY_DEADLINE_SEC=15
# 轻聊快速通道：寒暄/道谢等整句白名单消息跳过检索直出（首字 ~2s）；置 0 恢复全管线
LIGHT_CHAT_ENABLED=1

# 热重载（开发调试时设为 1；默认 0，避免 .py 文件变动触发服务重启）
APP_RELOAD=0

# API 服务配置
API_HOST=127.0.0.1
API_PORT=8000
LOG_DIR=./logs
# worker 数：单 worker 时 BM25 等纯 Python 计算吃 GIL，高并发会排队；
# 8GB 内存服务器建议 2，16GB 建议 4（每 worker 独立加载模型约 2.5GB）
APP_WORKERS=1

# CORS 允许来源（逗号分隔；上线后填具体域名，如 https://example.com）
CORS_ORIGINS=*

# 上线安全：限流 / 配额 / 上传限制 / 会话持久化
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=300
UPLOAD_LIMIT_PER_DAY=20
UPLOAD_MAX_MB=10
SESSION_DB_PATH=./data/sessions.db
SESSION_TTL_DAYS=7

# 成本 / 监控
MONITOR_DB_PATH=./data/usage.db
MONITOR_TOKEN=            # 上线前务必设置，保护 /admin/stats
COST_INPUT_PER_1M=1.0     # 元 / 百万输入 token
COST_OUTPUT_PER_1M=2.0    # 元 / 百万输出 token

# ---- 网络防护（2026-09 新增，对应 src/api/security.py）----
# 安全响应头（CSP / nosniff / X-Frame-Options / Referrer-Policy / Permissions-Policy / COOP）
SECURITY_HEADERS_ENABLED=1
# HSTS：仅在 HTTPS（nginx + 证书）就绪后开启，HTTP 下发了也会被浏览器忽略
SECURITY_HSTS_ENABLED=0
# 全局兜底限流：单 IP 每分钟请求上限（静态资源/健康检查/CORS 预检不计）。
# 与上面的 RATE_LIMIT_* 业务分桶限流是两套：这个兜住没被业务限流覆盖到的接口
GLOBAL_RATE_LIMIT_PER_MINUTE=120
# 单请求体大小上限（MB），超出直接 413，不进业务层
MAX_REQUEST_BODY_MB=8
