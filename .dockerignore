# ============================================================
# 促膝 · Docker 构建上下文过滤
#
# 两个目的，安全的那个更重要：
#
# 1. 安全。.env 存有 LLM API Key，而 Dockerfile 的 COPY . . 会把它写进镜像层。
#    镜像层可以被 docker history 与解包提取，等于把密钥随镜像一起分发出去。
#    运行时密钥由 docker-compose 的 env_file 从宿主机注入，镜像里不需要它。
#
# 2. 体积。本地全量目录约 4.2 GB，真正需要进镜像的只有约 16 MB。
#    语料电子书 1.9 GB、向量库 841 MB、.venv 1.3 GB 原本都会被打进构建上下文；
#    其中向量库 / 会话库 / 日志由 docker-compose 的卷挂载在运行时提供。
#
# 语法说明：每行一条规则，路径相对构建上下文根目录；
# 以 / 结尾的是目录规则，会连同子目录一并排除。
# 本文件只影响 docker build 的上下文，不影响本地文件与本地测试。
# ============================================================

# ---- 密钥与凭据：绝不能进镜像 ----
.env
.env.local
.env.*.local
data/user_config.json

# ---- 本地虚拟环境与构建缓存（约 1.3 GB，镜像内依赖由 pip 重装）----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 前端工具链（本地调试用；运行时前端由 FastAPI 直接托管 static 目录）----
node_modules/

# ---- 向量库（841 MB）：运行时由卷挂载提供，重灌即可再生成 ----
chroma_db/

# ---- 语料电子书（约 1.9 GB）：受著作权保护，且重灌即可再生成 ----
# 目录规则在前、扩展名规则在后，双保险；中文目录名即使匹配失败也还有扩展名兜底
data/persona_chat/jung/荣格/
data/persona_chat/adler/阿德勒/
data/persona_chat/wangyangming/电子书（54本）/
data/persona_chat/**/*.pdf
data/persona_chat/**/*.epub
data/persona_chat/**/*.mobi
data/persona_chat/**/*.azw3
data/persona_chat/**/*.djvu
data/persona_chat/**/*.txt

# ---- 运行期数据（会话 / 账号 / 用量 / 反馈 / 自建角色 / 图谱）----
# 全部由卷挂载提供；镜像里出现这些只会把本机数据带出去
data/*.db
data/*.db-shm
data/*.db-wal
data/*.json
data/persona_chat/custom/
data/persona_chat/graphs/
data/persona_chat/memory/
data/raw/*

# 保留：data/persona_chat/**/*.md（角色卡与人设材料，约 0.15 MB，属源码）

# ---- 个人成长记录与协作文档：仓库与镜像都不分发 ----
# 分发边界是「只分发可运行代码」，这些含个人成长记录、队友真实姓名与职业规划，
# 虽然已被 .gitignore 挡在仓库外，但 COPY . . 仍会把它们打进镜像，故在此再挡一层
项目日记.md
项目日记归档/
GUIDE.md
DEPLOY.md

# ---- 一次性脚本与 AI 对话残留 ----
优化.py

# ---- 本地产物与日志 ----
output/
logs/
*.log
*.log.*

# ---- 版本控制与协作元数据 ----
.git/
.gitignore
.gitattributes
.workbuddy/

# ---- 编辑器与系统文件 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 生产镜像不带测试与本地文档 ----
tests/
docs/
