# ============================================================
# 环境变量（千万别提交！）
# ============================================================
.env

# 用户在浏览器「模型设置」页填的 LLM 配置（含 API Key，绝不入库）
data/user_config.json
data/user_config.json.tmp

# ============================================================
# 个人材料（对外开源仓库绝不能带）
# ============================================================
# AI 协作记忆：含手机号、邮箱、服务器信息、职业规划
.workbuddy/

# output/ 是本地产物目录：含个人简历、大创项目计划书（队友真实姓名）、
# 商业与职业规划草稿、评估中间数据。需要公开的文档统一放 docs/
output/

# ============================================================
# 个人成长记录与 AI 协作产物：不进仓库（本地文件保留，仅不接受版本管理）
# 仓库只放可运行的项目代码，不放"我学到什么/我为什么做这个"
# ============================================================
项目日记.md
项目日记归档/
GUIDE.md
DEPLOY.md
docs/
scripts/warmup/

# ============================================================
# 运行时数据（会话 / 账号 / 用量 / 反馈 / 记忆 / 图谱）
# ============================================================
data/*.db
data/*.db-shm
data/*.db-wal
data/session_meta.json
data/deleted_sessions.json
# 自建角色与知识图谱：用户运行期产生，不属于源码
data/persona_chat/custom/
data/persona_chat/graphs/
data/persona_chat/memory/
# 上传的原始文档
data/raw/*

# 大体积原始语料（均为公开书籍，重灌即可再生成；不入库避免仓库膨胀）
data/persona_chat/jung/荣格/
data/persona_chat/wangyangming/电子书（54本）/

# ============================================================
# 已出版图书电子版：受著作权保护，任何情况下都不入库、不进历史
# （《被讨厌的勇气》《王阳明大传》等均为在售图书，公开分发属侵权）
# ============================================================
data/persona_chat/**/*.pdf
data/persona_chat/**/*.epub
data/persona_chat/**/*.mobi
data/persona_chat/**/*.txt
data/persona_chat/**/*.azw3
data/persona_chat/**/*.djvu

# ============================================================
# 日志
# ============================================================
*.log
logs/

# ============================================================
# 依赖与缓存
# ============================================================
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
chroma_db/

# ============================================================
# 一次性脚本 / 历史 scratch
# ============================================================
优化.py
tests/_*
tests/*_run.log

# ============================================================
# 编辑器 / 系统文件
# ============================================================
.idea/
.vscode/
.DS_Store
Thumbs.db
